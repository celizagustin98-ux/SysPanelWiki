# ─── Nodara · configuración ──────────────────────────────────────────────
# Copiar a .env y completar. Nunca subir .env al repositorio.

# Base de datos (instalación directa / Proxmox LXC). Con Docker se arma sola desde POSTGRES_*.
DATABASE_URL=postgresql://nodara:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/nodara
DATABASE_SSL=false
# PG_POOL_MAX=10

# Solo Docker: credenciales del contenedor PostgreSQL (usar letras y números, sin símbolos).
POSTGRES_USER=nodara
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=nodara
# APP_PORT=3090

# OBLIGATORIO: clave para cifrar las credenciales guardadas. Generar con: openssl rand -base64 48
# Si se pierde, los secretos guardados no se pueden recuperar. Guardala en lugar seguro.
SECRETS_ENCRYPTION_KEY=

# Servidor
PORT=3090
HOST=127.0.0.1
TZ=America/Argentina/Buenos_Aires
FILE_STORAGE_DIR=/var/lib/nodara/storage
MAX_JSON_BYTES=1048576
MAX_UPLOAD_BYTES=10485760

# Altas: false = solo un administrador crea usuarios (recomendado).
ALLOW_PUBLIC_SIGNUP=false

# Mantenimiento
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Estamos actualizando Nodara. El servicio vuelve en breve.

# Botón "Actualizar" de Configuración (solo instalación directa con git, no Docker)
ENABLE_WEB_UPDATES=false
GITHUB_REPO=celizagustin98-ux/SysPanelWiki
GITHUB_BRANCH=main
SERVICE_NAME=nodara
