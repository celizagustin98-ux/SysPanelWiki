DATABASE_URL=postgresql://syswiki:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/syswiki
DATABASE_SSL=false
FILE_STORAGE_DIR=./storage
GITHUB_REPO=celizagustin98-ux/SysPanelWiki
MAX_JSON_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
# PRODUCCIÓN: false — solo un admin crea usuarios.
# Desarrollo: true permite registro público (rol consulta).
ALLOW_PUBLIC_SIGNUP=false
ENABLE_WEB_UPDATES=false
# Activar pagina de mantenimiento (503) sin bajar el proceso Node.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Estamos actualizando SysIntranet. El servicio vuelve en breve.
# OBLIGATORIO en producción: clave de 32+ caracteres para cifrar la bóveda (AES-256-GCM).
# Generar: openssl rand -base64 48
SECRETS_ENCRYPTION_KEY=
# Pool Postgres (opcional)
# PG_POOL_MAX=10
